{"version":1,"cards":[{"id":"col001","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"The board will ___ a decision on Friday.","answer":"make","alt":[],"en":"make a decision","fa":"تصمیم گرفتن","note":"make + decision. Never 'do a decision'.","traps":[],"distractors":["do","take"]},{"id":"col002","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Founders must ___ a risk to grow.","answer":"take","alt":[],"en":"take a risk","fa":"ریسک کردن","note":"take a risk, take risks","traps":[],"distractors":["make","do"]},{"id":"col003","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Please ___ attention to the deadline.","answer":"pay","alt":[],"en":"pay attention","fa":"توجه کردن","note":"pay attention to something","traps":[],"distractors":["give","put"]},{"id":"col004","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Our team ___ research on battery life.","answer":"does","alt":[],"en":"do research","fa":"تحقیق کردن","note":"do research (never 'make research')","traps":[],"distractors":["makes","takes"]},{"id":"col005","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"You have ___ progress this month.","answer":"made","alt":[],"en":"make progress","fa":"پیشرفت کردن","note":"make progress","traps":[],"distractors":["taken","done"]},{"id":"col006","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"A manager should ___ responsibility for mistakes.","answer":"take","alt":[],"en":"take responsibility","fa":"مسئولیت پذیرفتن","note":"take responsibility for something","traps":[],"distractors":["make","give"]},{"id":"col007","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"We shipped on time and ___ the deadline.","answer":"met","alt":[],"en":"meet a deadline","fa":"ضرب‌الاجل را رعایت کردن","note":"meet a deadline (past: met)","traps":[],"distractors":["took","caught"]},{"id":"col008","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"She always ___ her promises.","answer":"keeps","alt":[],"en":"keep a promise","fa":"به قول عمل کردن","note":"keep a promise","traps":[],"distractors":["makes","does"]},{"id":"col009","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"It is hard to ___ a habit overnight.","answer":"break","alt":[],"en":"break a habit","fa":"ترک عادت کردن","note":"break a habit","traps":[],"distractors":["cut","destroy"]},{"id":"col010","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"The final will ___ place on Sunday.","answer":"take","alt":[],"en":"take place","fa":"برگزار شدن","note":"take place = happen","traps":[],"distractors":["make","hold"]},{"id":"col011","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Small teams ___ a big role in open source.","answer":"play","alt":[],"en":"play a role","fa":"نقش داشتن","note":"play a role in something","traps":[],"distractors":["make","take"]},{"id":"col012","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"If you ___ an effort, your writing improves fast.","answer":"make","alt":[],"en":"make an effort","fa":"تلاش کردن","note":"make an effort","traps":[],"distractors":["do","take"]},{"id":"col013","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Two hundred students ___ part in the contest.","answer":"took","alt":[],"en":"take part","fa":"شرکت کردن","note":"take part in","traps":[],"distractors":["made","gave"]},{"id":"col014","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"After the data came in, we ___ to a conclusion.","answer":"came","alt":[],"en":"come to a conclusion","fa":"به نتیجه رسیدن","note":"come to / reach a conclusion","traps":[],"distractors":["went","arrived"]},{"id":"col015","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"The report ___ a question about safety.","answer":"raises","alt":[],"en":"raise a question","fa":"سؤالی مطرح کردن","note":"raise a question","traps":[],"distractors":["gives","asks out"]},{"id":"col016","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Both sides finally ___ an agreement.","answer":"reached","alt":[],"en":"reach an agreement","fa":"به توافق رسیدن","note":"reach an agreement","traps":[],"distractors":["got","took"]},{"id":"col017","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"I have an ___ with the dentist at five.","answer":"appointment","alt":[],"en":"make an appointment","fa":"وقت گرفتن","note":"make an appointment with","traps":[],"distractors":["rendezvous","arrangement"]},{"id":"col018","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Smoking does ___ to your lungs.","answer":"harm","alt":[],"en":"do harm","fa":"آسیب رساندن","note":"do harm (never 'make harm')","traps":[],"distractors":["damage word: hurts","make"]},{"id":"col019","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"He ___ money by repairing bikes.","answer":"makes","alt":[],"en":"make money","fa":"پول درآوردن","note":"make money","traps":[],"distractors":["does","takes"]},{"id":"col020","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Let's ___ a break before the next module.","answer":"take","alt":[],"en":"take a break","fa":"استراحت کردن","note":"take a break","traps":[],"distractors":["make","have on"]},{"id":"col021","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"It is easy to ___ friends at a new job.","answer":"make","alt":[],"en":"make friends","fa":"دوست پیدا کردن","note":"make friends with someone","traps":[],"distractors":["do","get"]},{"id":"col022","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"We should ___ in touch after the course.","answer":"keep","alt":[],"en":"keep in touch","fa":"در تماس بودن","note":"keep in touch with someone","traps":[],"distractors":["stay touch","hold"]},{"id":"col023","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"I lost ___ of time while reading.","answer":"track","alt":[],"en":"lose track of time","fa":"حس زمان را از دست دادن","note":"lose track of","traps":[],"distractors":["line","watch"]},{"id":"col024","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Your explanation doesn't ___ sense.","answer":"make","alt":[],"en":"make sense","fa":"منطقی بودن","note":"make sense; questions: does it make sense?","traps":[],"distractors":["do","have"]},{"id":"col025","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"This change will ___ a difference to air quality.","answer":"make","alt":[],"en":"make a difference","fa":"تأثیر گذاشتن","note":"make a difference","traps":[],"distractors":["do","give"]},{"id":"col026","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Engineers must ___ these costs into account.","answer":"take","alt":[],"en":"take into account","fa":"در نظر گرفتن","note":"take something into account","traps":[],"distractors":["make","put"]},{"id":"col027","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"___ the truth, she was nervous.","answer":"Telling","alt":[],"en":"tell the truth","fa":"راستش را بخواهی","note":"tell the truth / to tell you the truth","traps":[],"distractors":["Saying","Speaking"]},{"id":"col028","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Could you ___ me a favor?","answer":"do","alt":[],"en":"do someone a favor","fa":"لطفی کردن","note":"do someone a favor","traps":[],"distractors":["make","give"]},{"id":"col029","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Please ___ care of the invoices today.","answer":"take","alt":[],"en":"take care of","fa":"رسیدگی کردن","note":"take care of something","traps":[],"distractors":["make","hold"]},{"id":"col030","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"The new chip will ___ the lead in speed.","answer":"take","alt":[],"en":"take the lead","fa":"پیشتاز شدن","note":"take the lead in","traps":[],"distractors":["make","get over"]},{"id":"col031","unit":"colloc_core","skill":"collocation","level":"B2","kind":"cloze","prompt":"Wages failed to ___ pace with rent.","answer":"keep","alt":[],"en":"keep pace with","fa":"هم‌قدم بودن با","note":"keep pace with something","traps":[],"distractors":["make pace","catch"]},{"id":"col032","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"Two years of patience finally ___ fruit.","answer":"bore","alt":[],"en":"bear fruit","fa":"ثمر دادن، نتیجه دادن","note":"bear fruit (past: bore)","traps":[],"distractors":["made","gave"]},{"id":"col033","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"The minister ___ under pressure to resign.","answer":"came","alt":[],"en":"come under pressure","fa":"تحت فشار قرار گرفتن","note":"come under pressure to do something","traps":[],"distractors":["took","felt on"]},{"id":"col034","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"The protest movement is ___ momentum.","answer":"gaining","alt":[],"en":"gain momentum","fa":"شتاب گرفتن","note":"gain/lose momentum","traps":[],"distractors":["taking","doing"]},{"id":"col035","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"The design fails to ___ the second criterion.","answer":"meet","alt":[],"en":"meet a criterion","fa":"معیار را برآورده کردن","note":"meet criteria/standards","traps":[],"distractors":["reach","fill"]},{"id":"col036","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"Rising costs ___ a challenge to exporters.","answer":"pose","alt":[],"en":"pose a challenge","fa":"چالشی ایجاد کردن","note":"pose a challenge/threat/question","traps":[],"distractors":["make","raise up"]},{"id":"col037","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"The campaign ___ awareness about water use.","answer":"raised","alt":[],"en":"raise awareness","fa":"آگاهی‌بخشی کردن","note":"raise awareness of something","traps":[],"distractors":["gave","lifted"]},{"id":"col038","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"Her lecture ___ light on an obscure dispute.","answer":"shed","alt":[],"en":"shed light on","fa":"روشن کردن یک موضوع","note":"shed light on (past: shed)","traps":[],"distractors":["lit","threw on"]},{"id":"col039","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"A mediator can ___ the gap between the sides.","answer":"bridge","alt":[],"en":"bridge the gap","fa":"شکاف را پر کردن","note":"bridge/narrow the gap","traps":[],"distractors":["fill over","tie"]},{"id":"col040","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"The bank moved to ___ inflation.","answer":"curb","alt":[],"en":"curb inflation","fa":"مهار تورم","note":"curb = restrain","traps":[],"distractors":["cut down","stopper"]},{"id":"col041","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"She ___ the opportunity to study abroad.","answer":"seized","alt":[],"en":"seize the opportunity","fa":"از فرصت استفاده کردن","note":"seize an opportunity","traps":[],"distractors":["caught","grabbed on"]},{"id":"col042","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"Chairmen ___ influence through the board.","answer":"wield","alt":[],"en":"wield influence","fa":"نفوذ اعمال کردن","note":"wield influence/power","traps":[],"distractors":["carry on","swing"]},{"id":"col043","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"Analysts ___ doubts about the forecast.","answer":"harbor","alt":[],"en":"harbor doubts","fa":"تردید در دل داشتن","note":"harbor doubts/reservations","traps":[],"distractors":["keep in","feed"]},{"id":"col044","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"The delay ___ additional costs.","answer":"incurred","alt":[],"en":"incur costs","fa":"هزینه‌ای تحمیل کردن","note":"incur costs/losses (past: incurred)","traps":[],"distractors":["charged","brought in"]},{"id":"col045","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"The state may ___ a tax on sugary drinks.","answer":"levy","alt":[],"en":"levy a tax","fa":"مالیات وضع کردن","note":"levy a tax on","traps":[],"distractors":["put","raise on"]},{"id":"col046","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"Hedging can ___ losses in volatile markets.","answer":"offset","alt":[],"en":"offset losses","fa":"جبران زیان","note":"offset something with/by","traps":[],"distractors":["outweigh","repair"]},{"id":"col047","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"The teaser was designed to ___ interest.","answer":"pique","alt":[],"en":"pique interest","fa":"کنجکاوی برانگیختن","note":"pique interest/curiosity","traps":[],"distractors":["pick","rise"]},{"id":"col048","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"The methodology will not ___ scrutiny.","answer":"stand","alt":[],"en":"stand scrutiny","fa":"زیر ذره‌بین دوام آوردن","note":"stand/bear scrutiny","traps":[],"distractors":["carry","hold up on"]},{"id":"col049","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"Patient investors ___ the benefits later.","answer":"reaped","alt":[],"en":"reap benefits","fa":"برداشت کردن از نتایج","note":"reap rewards/benefits","traps":[],"distractors":["cut","collected up"]},{"id":"col050","unit":"colloc_c1","skill":"collocation","level":"C1","kind":"cloze","prompt":"Years of drou