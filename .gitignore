test
prompt

server.log
# Skills directory
/skills/
# env secrets - never commit
.env
.env.local
.env*.local

# runtime data - not for the public repo
db/custom.db

# data survival (the 2026-10-20 lesson): backups/ IS tracked - it is the only
# thing that survives environment rebuilds. Only transient state stays out.
backups/.last-autosnap
backups/.vacuum-*
backups/.tmp-*
/rah-web-export/
/rah-repo/

# external research artifacts (root-owned, unreadable at build time - Turbopack dies on these)
/research/
/shots/
# local deliverables & screenshots - not repo content
/download/
/agent-ctx/
/rah/
/rah-run/
/tool-results/
scripts/*.json
# Duolingo RE data artifacts (re-downloadable; see DUOLINGO-RE.md §1)
scripts/duolingo-reference/traces.csv.gz
scripts/duolingo-reference/traces.part
scripts/duolingo-reference/sample.csv
scripts/duolingo-reference/chunk.bin
scripts/duolingo-reference/parity_fixture.json
scripts/duolingo-reference/parity_ref_out.json
scripts/duolingo-reference/dl.log
scripts/duolingo-reference/dl2.log
